# Where the API lives. Empty = same origin (the Vite proxy in development, FastAPI in the built product).
VITE_API_URL=
# live = real sign-in with tokens; mock = no sign-in, send X-Mock-Role (developer only).
VITE_AUTH_MODE=live
# api = call the backend; fixtures = serve the JSON in src/fixtures (offline safety net).
VITE_DATA_MODE=api
# true = include the developer tools panel and presenter mode. Leave unset for real users.
VITE_DEV_TOOLS=
