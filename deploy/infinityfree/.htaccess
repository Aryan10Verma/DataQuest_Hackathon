# prismav.xo.je -> the full PRISM on Render. InfinityFree can't run Python, so it only forwards visitors.
# 1. Points at prismav.onrender.com; if the Render address ever changes, update it here and in index.html.
# 2. Upload this file and index.html to htdocs/ in the InfinityFree File Manager.
RewriteEngine On
RewriteRule ^(.*)$ https://prismav.onrender.com/$1 [R=302,L]
