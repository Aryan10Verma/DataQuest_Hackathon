# prismav.xo.je -> PRISM's website on Vercel (which forwards the API to Render). InfinityFree can't run
# Python, so it only forwards visitors.
# 1. Points at dataquesthackathon-frontend.vercel.app; if that address changes, update it here and in index.html.
# 2. Upload this file and index.html to htdocs/ in the InfinityFree File Manager.
RewriteEngine On
RewriteRule ^(.*)$ https://dataquesthackathon-frontend.vercel.app/$1 [R=302,L]
