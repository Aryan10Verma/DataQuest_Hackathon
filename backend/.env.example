# PRISM Engine backend configuration. Copy to .env and adjust.
APP_ENV=dev
# true  -> every endpoint returns schema-identical fixtures (no DB needed)
# false -> live services (DB + engine). Run `python scripts/seed.py` first.
MOCK_MODE=true
DATABASE_URL=sqlite:///./prism.db
# DATABASE_URL=postgresql+psycopg://prism:prism@localhost:5432/prism
# Secrets live only in this file (never in git, never in the website). start.py fills both with random
# values on first run; APP_ENV=production refuses to start with the placeholder or without the key.
JWT_SECRET=change-me-in-production-at-least-32-chars
# Encrypts phone numbers and free-text notes at rest. Never change it once data exists.
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
# Per-IP budget for sign-in, sign-up and token refresh (accounts also lock for 15 min after 5 bad passwords)
AUTH_RATE_LIMIT_PER_MINUTE=10
# Larger request bodies are refused
MAX_BODY_BYTES=1000000
# Redirect http -> https and send HSTS. Empty = on when APP_ENV=production.
FORCE_HTTPS=
# The refresh token is kept in an HttpOnly, SameSite=Strict cookie; false only for plain-http test hosts
COOKIE_SECURE=true
# Optional path to Person 3's model artefact; absent -> deterministic cosine fallback
ML_MODEL_PATH=
ML_ALPHA=0.5
LOG_LEVEL=INFO
# Built website to serve next to the API. Empty = ../frontend/dist when it exists; none = API only.
FRONTEND_DIST=
# Optional live job-postings feed for market signals (free key: https://developer.adzuna.com).
# Leave empty to run on the versioned snapshot only; the API says so in /system/data-status.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_DAILY_BUDGET=200
# Developer / judging tools, OFF for real users: /api/v1/demo/* endpoints and a frozen "today".
# APP_ENV=production refuses to start with DEMO_MODE or MOCK_MODE on.
DEMO_MODE=false
# Frozen "today" (YYYY-MM-DD), applied only while DEMO_MODE=true; empty = real date
DEMO_TODAY=
# Optional language model for plain-language summaries and Tamil/Hindi translation (never used for scoring).
# Any OpenAI-compatible endpoint works. Empty key = fixed templates. Calls are made by this server, so the
# server needs internet access to the endpoint (a blocked campus network falls back to templates).
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4
GROK_TIMEOUT_SEC=12
# Deadline reminders (scripts/send_reminders.py, run daily). console = log only; twilio = SMS / WhatsApp.
# India: SMS needs DLT registration of sender ID and templates; WhatsApp needs approved message templates.
REMINDER_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=
